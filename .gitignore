node_modules/
data/
dist/
dist-appsail/
.env
.env.*
# ...but never the example files. Without these negations both .env.example and
# server/.env.appsail.example are tracked-but-ignored, so editing either needs
# `git add -f` — and `git add -f server/.env.*` typed in a hurry force-adds the real
# server/.env.appsail, which holds live Neon credentials. Keep `-f` away from this path.
!.env.example
!**/.env.*.example
*.log
e2e/shots/

# Local dev/test Postgres cluster (scripts/pg-dev.mjs) — throwaway, tests create schemas per run
.pgdata/

# Design-baseline captures (e2e/capture-screenshots.mjs): 25 MB of PNGs that are
# regenerable output, so they stay out of git — but baseline/*/README.md records the
# capture conditions and IS tracked, since a baseline you can't reproduce is worthless.
e2e/baseline/**/*.png

# macOS Finder metadata — regenerated constantly, never wanted in git
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
