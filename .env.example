# Single source of truth for this repo's local dev port block (see
# ~/.claude/docs/port-allocation.md). web (vite) = PORT_BASE, api (server) =
# PORT_BASE + 1. Set PORT explicitly to override the derived api port (e.g.
# for Docker Compose, which maps host 3000 -> container 3000).
PORT_BASE=43100
DB_PATH=./data/tripplanner.db
UPLOADS_DIR=./data/uploads
JWT_SECRET=change-me-32-chars-minimum-random
DEFAULT_CURRENCY=INR
# LLM: none | anthropic | openai | mock  (openai driver also covers Ollama via LLM_BASE_URL)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
