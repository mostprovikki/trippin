# Single source of truth for this repo's local dev port block (see
# ~/.claude/docs/port-allocation.md). web (vite) = PORT_BASE, api (server) =
# PORT_BASE + 1. Set PORT to pin the api port explicitly instead.
#
# Docker Compose sets PORT=3000 itself so the in-container port is fixed, and
# maps host API_PORT (default 43101) to it. Leave PORT unset here, or Compose's
# host mapping and the app's listen port will disagree.
PORT_BASE=43100
# Local dev: run `npm run db:up` first, it starts a Postgres matching this default.
# Production (Neon): a real Neon connection string + DB_DRIVER=neon.
DATABASE_URL=postgres://tripper:tripper@127.0.0.1:43105/tripper_test
DB_DRIVER=pg
UPLOADS_DIR=./data/uploads
JWT_SECRET=change-me-32-chars-minimum-random
DEFAULT_CURRENCY=INR
# LLM: none | anthropic | openai | mock  (openai driver also covers Ollama via LLM_BASE_URL)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
